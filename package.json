{
  "name": "desk-buddy",
  "version": "0.1.0",
  "description": "A cute desktop companion: pomodoro, reminders, to-dos, Spotify controls, app-aware reactions",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "rcedit": "^4.0.1"
  },
  "license": "MIT",
  "author": "Vaibhav Patil",
  "homepage": "https://github.com/quark-aim/desk-buddy",
  "build": {
    "appId": "com.deskbuddy.app",
    "productName": "Desk Buddy",
    "copyright": "MIT License",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Desk-Buddy-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Desk-Buddy-Portable-${version}.exe"
    },
    "afterPack": "build/afterPack.js"
  }
}
